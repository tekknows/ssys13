# Backend process environment. This file is not loaded automatically.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Local browser dashboard endpoint; set the actual runtime URL in dashboard config as appropriate.
API_BASE_URL=http://localhost:3000/api/supabase-sync
PORT=3000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Server-side only. Never expose these in the browser or extension.
# SUPABASE_SECRET_KEY=your_secret_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# ADMIN_SESSION_SECRET should be a random value of at least 32 characters.
# ADMIN_SESSION_SECRET=generate_a_unique_random_secret
